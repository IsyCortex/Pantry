PORT=3000
DATABASE_URL=postgres://pantry:pantry@127.0.0.1:15432/pantry

# Input-analysis provider: fake (default; deterministic and offline) or local
# (Ollama /api/generate protocol).
ANALYZER_PROVIDER=fake
# Local model server settings, used only when ANALYZER_PROVIDER=local.
ANALYZER_LOCAL_URL=http://127.0.0.1:11434
ANALYZER_LOCAL_MODEL=llama3.2
# Wall-clock budget for a single analyzer call, in milliseconds (contract max: 15000).
ANALYZER_TIMEOUT_MS=15000
# IANA timezone used to derive the analyzer reference date (defaults to UTC).
ANALYZER_TIMEZONE=UTC

# IANA timezone used to derive the inventory expiration-status "today"
# (Ticket 3.1). Deliberately separate from ANALYZER_TIMEZONE: the analyzer and
# inventory expiration have separate responsibilities. Defaults to Europe/Berlin
# per docs/domain-model.md; a future per-account/household model should supply
# this value.
EXPIRATION_TIMEZONE=Europe/Berlin
# Calendar days within which a dated item is expiring_soon (expires today or
# within N days). Defaults to 3; fixed by Ticket 3.1, centralized so it can be
# re-tuned later without UI changes.
EXPIRATION_SOON_DAYS=3
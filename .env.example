PORT=3000
DATABASE_URL=postgres://pantry:pantry@127.0.0.1:15432/pantry

# Input-analysis provider: fake (default; deterministic and offline) or local
# (Ollama /api/generate protocol).
ANALYZER_PROVIDER=fake
# Local model server settings, used only when ANALYZER_PROVIDER=local.
ANALYZER_LOCAL_URL=http://127.0.0.1:11434
ANALYZER_LOCAL_MODEL=llama3.2
# Wall-clock budget for a single analyzer call, in milliseconds (contract max: 15000).
ANALYZER_TIMEOUT_MS=15000
# IANA timezone used to derive the analyzer reference date (defaults to UTC).
ANALYZER_TIMEZONE=UTC
<!DOCTYPE html>
<html lang="en">
  <%- include('partials/head', { title }) %>
  <body>
    <%- include('partials/nav', { notice }) %>
    <main>
      <h1><%= title %></h1>
      <p class="subtle">Describe the items you bought. Proposed items always go to a review step first — nothing is added to the inventory without your confirmation.</p>

      <% if (errors.length > 0) { %>
        <section class="errors">
          <h2>Analysis problems</h2>
          <ul>
            <% errors.forEach((error) => { %>
              <li><%= error %></li>
            <% }) %>
          </ul>
        </section>
      <% } %>

            <form method="post" action="/batches/natural-language">
        <label for="rawText">Grocery description</label>
        <textarea id="rawText" name="rawText" rows="6" placeholder="e.g. Fridge: two cartons of milk best before 20 August. Maybe some rice."><%= rawText %></textarea>
        <button id="analyzeButton" type="submit" class="primary-btn">Analyze items</button>
      </form>

      <!-- Ticket 4.3 — loading state so analysis has a distinct, non-blank
           progress indicator instead of a silent submit. -->
      <script>
        (function () {
          const form = document.forms[0];
          const button = document.getElementById('analyzeButton');
          if (!form || !button) return;
          form.addEventListener('submit', function () {
            button.disabled = true;
            button.setAttribute('aria-busy', 'true');
            button.textContent = 'Analyzing items…';
          });
        })();
      </script>

      <p><a href="/batches/manual">Continue with a manual intake batch instead</a></p>
    </main>
  </body>
</html>
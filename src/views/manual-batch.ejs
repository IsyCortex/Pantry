<!DOCTYPE html>
<html lang="en">
  <%- include('partials/head', { title }) %>
  <body>
    <%- include('partials/nav', { notice }) %>
    <main>
      <h1><%= title %></h1>
      <p class="subtle">Enter your items and save the batch straight to the active inventory.</p>

      <% if (errors.length > 0) { %>
        <section class="errors">
          <h2>Validation errors</h2>
          <ul>
            <% errors.forEach((error) => { %>
              <li><%= error %></li>
            <% }) %>
          </ul>
        </section>
      <% } %>

      <form method="post" action="/batches/manual">
        <input type="hidden" name="batchId" value="<%= batchId %>" />

        <div class="toolbar">
          <label>
            Default location for newly created rows
            <select name="defaultLocation">
              <option value="">No default</option>
              <% locations.forEach((location) => { %>
                <option value="<%= location %>" <%= defaultLocation === location ? 'selected' : '' %>><%= location %></option>
              <% }) %>
            </select>
          </label>
          <button type="submit" name="action" value="add-row">Add row</button>
          <button type="submit" name="action" value="save">Save draft batch</button>
          <button type="submit" name="action" value="save-to-inventory" class="primary-btn">Save to inventory</button>
        </div>

        <section class="batch-grid">
          <% rows.forEach((row, index) => { %>
            <article class="batch-row">
              <div class="row-actions">
                <strong>Row <%= index + 1 %></strong>
                <button type="submit" name="action" value="move-up" name="action" formaction="/batches/manual" aria-label="Move row <%= index + 1 %> up">
                  <span class="sr-only">Move row <%= index + 1 %> up</span>Move up
                </button>
                <button type="submit" name="action" value="move-down" formaction="/batches/manual" name="action" aria-label="Move row <%= index + 1 %> down">
                  <span class="sr-only">Move row <%= index + 1 %> down</span>Move down
                </button>
                <button type="submit" name="action" value="duplicate-row" formaction="/batches/manual" name="action" aria-label="Duplicate row <%= index + 1 %>">
                  <span class="sr-only">Duplicate row <%= index + 1 %></span>Duplicate
                </button>
                <button type="submit" name="action" value="remove-row" formaction="/batches/manual" name="action" aria-label="Remove row <%= index + 1 %>">
                  <span class="sr-only">Remove row <%= index + 1 %></span>Remove
                </button>
                <button type="submit" name="action" value="enter-row" formaction="/batches/manual" name="action" aria-label="Advance from row <%= index + 1 %>">
                  <span class="sr-only">Advance from row <%= index + 1 %></span>Enter advances
                </button>
                <button type="submit" class="sr-only" name="actionRowIndex" value="<%= index %>" data-row-submit-index="<%= index %>">row-submit-index</button>
              </div>

              <div class="field-grid">
                <label>
                  Name
                  <input name="rows[<%= index %>][name]" value="<%= row.name %>" data-enter-target="name" data-name-suggest
                         autocomplete="off" role="combobox" aria-autocomplete="list"
                         aria-expanded="false" aria-controls="name-suggestions-<%= index %>" />
                  <ul class="name-suggestions" id="name-suggestions-<%= index %>" role="listbox"
                      aria-label="Previously used item names" hidden></ul>
                </label>

                <label>
                  Quantity
                  <input name="rows[<%= index %>][quantity]" inputmode="decimal" value="<%= row.quantity %>" data-enter-target="quantity" />
                </label>

                <label>
                  Unit
                  <select name="rows[<%= index %>][unit]" data-enter-target="unit">
                    <option value="">No unit</option>
                    <% units.forEach((unit) => { %>
                      <option value="<%= unit %>" <%= row.unit === unit ? 'selected' : '' %>><%= unit %></option>
                    <% }) %>
                  </select>
                </label>

                <label>
                  Location
                  <select name="rows[<%= index %>][location]" data-enter-target="location">
                    <option value="">No location yet</option>
                    <% locations.forEach((location) => { %>
                      <option value="<%= location %>" <%= row.location === location ? 'selected' : '' %>><%= location %></option>
                    <% }) %>
                  </select>
                </label>

                <label>
                  Expiration date
                  <input type="date" name="rows[<%= index %>][expirationDate]" value="<%= row.expirationDate %>" data-enter-target="expirationDate" />
                </label>

                <label>
                  Date type
                  <select name="rows[<%= index %>][dateType]" data-enter-target="dateType">
                    <option value="">No date type</option>
                    <% dateTypes.forEach((dateType) => { %>
                      <option value="<%= dateType %>" <%= row.dateType === dateType ? 'selected' : '' %>><%= dateType %></option>
                    <% }) %>
                  </select>
                </label>
              </div>
            </article>
          <% }) %>
        </section>
      </form>
      <script>
        (function () {
          const form = document.querySelector('form[action="/batches/manual"]');
          if (!form) return;

          form.addEventListener('keydown', (event) => {
            if (event.key !== 'Enter' || event.shiftKey || event.ctrlKey || event.metaKey || event.altKey) {
              return;
            }

            const target = event.target;
            if (!target || !target.name || !target.name.startsWith('rows[')) {
              return;
            }

            event.preventDefault();
            const match = target.name.match(/^rows\[(\d+)\]/);
            if (!match) {
              return;
            }

            const rowIndex = Number(match[1]);
            const currentRowTargets = Array.from(form.querySelectorAll(`[name^="rows[${rowIndex}]"][data-enter-target]`));
            const currentIndex = currentRowTargets.indexOf(target);
            const nextInRow = currentRowTargets[currentIndex + 1];
            if (nextInRow) {
              nextInRow.focus();
              return;
            }

            const nextRowFirstField = form.querySelector(`[name="rows[${rowIndex + 1}][name]"]`);
            if (nextRowFirstField) {
              nextRowFirstField.focus();
              return;
            }

            const submitter = form.querySelector(`button[data-row-submit-index="${rowIndex}"]`) || form.querySelector('button[name="action"][value="add-row"]');
            if (submitter && typeof form.requestSubmit === 'function') {
              form.requestSubmit(submitter);
            } else {
              form.submit();
            }
          });
        })();
      </script>
      <script>
        // Ticket 4.1 — accessible name-suggestion combobox for each entry
        // row's Name field. Progressive enhancement: the form works fully
        // without JavaScript. Suggestions are candidates only; choosing one
        // merely prefills the visible, editable fields of that row and the
        // batch still has to be saved explicitly ("Save to inventory").
        (function () {
          const SUGGESTION_URL = '/inventory/name-suggestions?q=';
          const DEBOUNCE_MS = 180;

          function setupCombobox(input) {
            const listId = input.getAttribute('aria-controls');
            const list = document.getElementById(listId);
            if (!list) return;

            let options = [];
            let activeIndex = -1;
            let debounceTimer = null;

            function setOpen(open) {
              list.hidden = !open;
              input.setAttribute('aria-expanded', open ? 'true' : 'false');
              if (!open) {
                activeIndex = -1;
                input.removeAttribute('aria-activedescendant');
              }
            }

            function paintActive() {
              Array.prototype.forEach.call(list.children, function (child, index) {
                child.classList.toggle('is-active', index === activeIndex);
              });
              if (activeIndex >= 0) {
                input.setAttribute('aria-activedescendant', list.id + '-opt-' + activeIndex);
              } else {
                input.removeAttribute('aria-activedescendant');
              }
            }

            function render(suggestions) {
              list.textContent = '';
              options = [];
              activeIndex = -1;
              suggestions.forEach(function (suggestion, index) {
                const item = document.createElement('li');
                item.id = list.id + '-opt-' + index;
                item.setAttribute('role', 'option');
                item.dataset.name = suggestion.name || '';
                item.dataset.location = suggestion.location || '';

                const name = document.createElement('span');
                name.className = 'suggestion-name';
                name.textContent = suggestion.name || '';
                item.appendChild(name);

                if (suggestion.location) {
                  const location = document.createElement('span');
                  location.className = 'suggestion-location';
                  location.textContent = '\u00b7 ' + suggestion.location;
                  item.appendChild(location);
                }

                const hint = document.createElement('span');
                hint.className = 'suggestion-hint';
                hint.textContent = 'Enter to prefill';
                hint.setAttribute('aria-hidden', 'true');
                item.appendChild(hint);

                list.appendChild(item);
                options.push(item);
              });

              setOpen(options.length > 0);
              if (options.length) {
                paintActive();
              }
            }

            async function loadSuggestions(queryText) {
              try {
                const response = await fetch(SUGGESTION_URL + encodeURIComponent(queryText), {
                  headers: { Accept: 'application/json' }
                });
                if (!response.ok) {
                  setOpen(false);
                  return;
                }
                const data = await response.json();
                render(Array.isArray(data.suggestions) ? data.suggestions : []);
              } catch (error) {
                setOpen(false);
              }
            }

            function choose(item) {
              input.value = item.dataset.name;

              const row = input.closest('.batch-row') || input.closest('article');
              const locationSelect = row ? row.querySelector('select[name$="[location]"]') : null;
              const wantedLocation = item.dataset.location || '';
              if (locationSelect && wantedLocation) {
                const hasOption = Array.prototype.some.call(locationSelect.options, function (option) {
                  return option.value === wantedLocation;
                });
                if (hasOption) {
                  locationSelect.value = wantedLocation;
                  locationSelect.dispatchEvent(new Event('change', { bubbles: true }));
                }
              }

              // Notify other row listeners of the prefill. Drop any pending
              // debounced load first: a keystroke issued just before the
              // selection must not resolve afterwards and reopen the list
              // over the freshly applied value.
              clearTimeout(debounceTimer);
              input.dispatchEvent(new Event('input', { bubbles: true }));
              setOpen(false);
              input.focus();
            }

            input.addEventListener('input', (event) => {
              // Suggestions react only to genuine edits of the field. A
              // programmatic input event (choose() dispatches one so other
              // row logic notices the prefill) would otherwise reschedule a
              // load for the just-applied name and pop the list open again:
              // after a selection the list stays closed until the content is
              // actually edited again.
              if (!event.isTrusted) {
                clearTimeout(debounceTimer);
                return;
              }
              clearTimeout(debounceTimer);
              const queryText = input.value;
              if (!queryText.trim()) {
                setOpen(false);
                return;
              }
              debounceTimer = setTimeout(() => { loadSuggestions(queryText); }, DEBOUNCE_MS);
            });

            // Runs after the row-advance keyboard handler registered earlier
            // on the same form; stopping propagation keeps both behaviors
            // from fighting while the suggestion list is open.
            input.addEventListener('keydown', (event) => {
              const isOpen = !list.hidden;

              if ((event.key === 'ArrowDown' || event.key === 'ArrowUp') && isOpen && options.length) {
                event.preventDefault();
                event.stopPropagation();
                const direction = event.key === 'ArrowDown' ? 1 : -1;
                activeIndex = Math.min(Math.max(activeIndex + direction, 0), options.length - 1);
                paintActive();
                return;
              }

              if (event.key === 'Enter' && isOpen && activeIndex >= 0) {
                event.preventDefault();
                event.stopImmediatePropagation();
                choose(options[activeIndex]);
                return;
              }

              if (event.key === 'Escape' && isOpen) {
                event.preventDefault();
                event.stopPropagation();
                setOpen(false);
              }
            });

            list.addEventListener('mousedown', (event) => {
              const target = event.target.closest('[role="option"]');
              if (!target) return;
              event.preventDefault(); // keep focus in the input while choosing
              choose(target);
            });

            input.addEventListener('focusout', (event) => {
              if (!list.contains(event.relatedTarget)) {
                setOpen(false);
              }
            });
          }

          document.querySelectorAll('input[data-name-suggest]').forEach(setupCombobox);
        })();
      </script>
    </main>
  </body>
  </html>
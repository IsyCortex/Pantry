<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <style>
      body { font-family: Arial, sans-serif; margin: 0; padding: 1rem; }
      main { max-width: 60rem; margin: 0 auto; }
      .inventory-list { display: grid; gap: 1rem; }
      .inventory-item { border: 1px solid #ccc; border-radius: 0.5rem; padding: 1rem; }
      .meta { color: #444; margin-top: 0.25rem; }
      .empty, .error { border: 1px dashed #888; border-radius: 0.5rem; padding: 1rem; }
      @media (min-width: 48rem) {
        .inventory-row { display: flex; justify-content: space-between; gap: 1rem; }
      }
    </style>
  </head>
  <body>
    <main>
      <h1><%= title %></h1>

      <% if (errorMessage) { %>
        <section class="error">
          <p><%= errorMessage %></p>
        </section>
      <% } else if (!items || items.length === 0) { %>
        <section class="empty">
          <p>No food has been added yet.</p>
          <p>Confirmed batches populate the inventory.</p>
          <p>Manual intake is the next step.</p>
        </section>
      <% } else { %>
        <section class="inventory-list">
          <% items.forEach((item) => { %>
            <article class="inventory-item">
              <div class="inventory-row">
                <strong><%= item.name %></strong>
                <span><%= item.location %></span>
              </div>
              <% if (item.quantity != null) { %>
                <p class="meta">Quantity: <%= item.quantity %><% if (item.unit) { %> <%= item.unit %><% } %></p>
              <% } %>
              <% if (item.expirationDate) { %>
                <p class="meta"><%= item.dateTypeLabel || 'Expiration date' %>: <%= item.expirationDate %></p>
              <% } else { %>
                <p class="meta">No expiration date</p>
              <% } %>
            </article>
          <% }) %>
        </section>
      <% } %>
    </main>
  </body>
  </html>
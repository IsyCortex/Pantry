<!DOCTYPE html>
<html lang="en">
  <%- include('partials/head', { title }) %>
  <body>
    <%- include('partials/nav', { notice }) %>
    <main>
      <h1><%= title %></h1>

      <section class="view-actions">
        <a href="/batches/manual" class="primary-btn" aria-label="Add item to inventory">+ Add item</a>
      </section>

      <% if (errorMessage) { %>
        <section class="error">
          <p><%= errorMessage %></p>
        </section>
      <% } else if (!totalCount) { %>
        <section class="empty">
          <p>No food has been added yet.</p>
          <p>Confirmed batches populate the inventory.</p>
          <p>Manual intake is the next step.</p>
        </section>
      <% } else { %>
        <section class="filter-toolbar" aria-label="Filter and search inventory">
          <form method="get" action="/inventory" class="filter-form">
            <label>
              Location
              <select name="location">
                <option value="">All locations</option>
                <% locations.forEach((loc) => { %>
                  <option value="<%= loc %>" <%= filters.location === loc ? 'selected' : '' %>><%= loc %></option>
                <% }) %>
              </select>
            </label>
            <label>
              Status
              <select name="status">
                <option value="">All statuses</option>
                <% statusOptions.forEach((option) => { %>
                  <option value="<%= option.value %>" <%= filters.status === option.value ? 'selected' : '' %>><%= option.label %></option>
                <% }) %>
              </select>
            </label>
            <label>
              Search by name
              <input type="search" name="q" value="<%= filters.q %>" placeholder="e.g. milk">
            </label>
            <button type="submit" class="primary-btn">Apply filters</button>
            <a href="/inventory">Clear</a>
          </form>
          <% if (filtersActive) { %>
            <p class="active-filters">
              Showing <%= items.length %> of <%= totalCount %> item(s). Active:
              <% if (filters.location) { %>
                <span class="filter-chip">Location: <%= filters.location %></span>
              <% } %>
              <% if (filters.statusLabel) { %>
                <span class="filter-chip">Status: <%= filters.statusLabel %></span>
              <% } %>
              <% if (filters.q) { %>
                <span class="filter-chip">Search: &quot;<%= filters.q %>&quot;</span>
              <% } %>
              <a href="/inventory">Clear all filters</a>
            </p>
          <% } %>
        </section>

        <% if (!items || items.length === 0) { %>
          <section class="empty empty-filtered">
            <p>No items match the active filters.</p>
            <p>The inventory itself is not empty &mdash; <a href="/inventory">clear all filters</a> to see all <%= totalCount %> item(s).</p>
          </section>
        <% } else { %>
        <section class="sort-toolbar" aria-label="Sort inventory">
          <span>Sort by:</span>
          <button type="button" data-sort="date" aria-pressed="false">Expiration date</button>
          <button type="button" data-sort="location" aria-pressed="false">Location</button>
        </section>
        <section class="inventory-list">
          <% items.forEach((item) => { %>
            <article class="inventory-item" data-date="<%= item.expirationDate || '' %>" data-location="<%= item.location %>" data-status="<%= item.expirationStatus || '' %>">
              <div class="inventory-row">
                <strong><%= item.name %></strong>
                <span><%= item.location %></span>
              </div>
              <p><a href="/inventory/<%= item.id %>/edit">Edit item</a></p>
              <% if (item.quantity != null) { %>
                <p class="meta">Quantity: <%= item.quantity %><% if (item.unit) { %> <%= item.unit %><% } %></p>
              <% } %>
              <% if (item.expirationDate) { %>
                <p class="meta"><%= item.dateTypeLabel || 'Expiration date' %>: <%= item.expirationDate %></p>
              <% } else { %>
                <p class="meta">No expiration date</p>
              <% } %>
              <% if (item.expirationStatusLabel) { %>
                <p class="meta"><span class="status-badge status-<%= item.expirationStatusClass %>"><span class="status-glyph" aria-hidden="true"><%= item.expirationStatusGlyph %></span><%= item.expirationStatusLabel %></span></p>
              <% } %>
            </article>
          <% }) %>
        </section>
        <script src="/inventory-sort.js"></script>
        <% } %>
      <% } %>
    </main>
  </body>
  </html>